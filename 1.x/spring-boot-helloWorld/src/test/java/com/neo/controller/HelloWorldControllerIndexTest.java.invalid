import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

public class HelloWorldControllerIndexTest {
    @Test
    @Tag("valid")
    public void verifyDefaultResponse() {
        HelloWorldController controller = new HelloWorldController();
        String expected = "Hello World";
        String actual = controller.index();
        assertEquals(expected, actual, "The index method should return 'Hello World'");
    }
    @Test
    @Tag("valid")
    public void ensureResponseConsistency() {
        HelloWorldController controller = new HelloWorldController();
        String expected = "Hello World";
        for (int i = 0; i < 5; i++) { // Test multiple invocations
            String actual = controller.index();
            assertEquals(expected, actual, "The index method should consistently return 'Hello World'");
        }
    }
    @Test
    @Tag("valid")
