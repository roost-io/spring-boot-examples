@ExtendWith(MockitoExtension.class)
public class MailServiceImplSendHtmlMailTest {
    @Mock
    private JavaMailSender mailSender;
    @InjectMocks
    private MailServiceImpl mailServiceImpl;
    private MimeMessage preparedMessage;
    private Logger slf4jLogger;
    private ListAppender<ILoggingEvent> listAppender;
    @BeforeEach
    void setUp() {
        // Prepare logger appender to capture logs
        slf4jLogger = (Logger) LoggerFactory.getLogger(MailServiceImpl.class);
        listAppender = new ListAppender<>();
        listAppender.start();
        slf4jLogger.addAppender(listAppender);
        // Configure dependencies in target under test
        preparedMessage = new MimeMessage((Session) null);
        when(mailSender.createMimeMessage()).thenReturn(preparedMessage);
        // TODO: change the sender address if needed
        ReflectionTestUtils.setField(mailServiceImpl, "from", (Object) "no-reply@example.com");
        ReflectionTestUtils.setField(mailServiceImpl, "mailSender", (Object) mailSender);
    }
    @AfterEach
    void tearDown() {
        if (slf4jLogger != null && listAppender != null) {
            slf4jLogger.detachAppender(listAppender);
            listAppender.stop();
        }
    }
    @Test
    @Tag("valid")
    public void sendHtmlMailWithValidInputsSendsSuccessfully() {
        // Arrange
        // TODO: change the recipient address if needed
        String to = "user@example.com";
        String subject = "Test HTML Mail";
        String content = "<h1>Hello</h1><p>This is a test.</p>";
        // Act
        mailServiceImpl.sendHtmlMail(to, subject, content);
        // Assert
        verify(mailSender, times(1)).createMimeMessage();
        verify(mailSender, times(1)).send(same(preparedMessage));
        List<ILoggingEvent> infoLogs = listAppender.list.stream()
                .filter(e -> e.getLevel() == Level.INFO)
                .collect(Collectors.toList());
        long successMsgCount = infoLogs.stream()
                .filter(e -> "html邮件发送成功".equals(e.getFormattedMessage()))
                .count();
        assertEquals((int) 1, (int) successMsgCount);
    }
    @Test
    @Tag("invalid")
    public void sendHtmlMailWithInvalidRecipientLogsErrorAndDoesNotSend() {
        // Arrange
        String invalidTo = "invalid address"; // Intentionally invalid to trigger MessagingException
        String subject = "Subject";
        String content = "<p>Body</p>";
        // Act
        mailServiceImpl.sendHtmlMail(invalidTo, subject, content);
        // Assert
        verify(mailSender, times(1)).createMimeMessage();
        verify(mailSender, never()).send(any(MimeMessage.class));
        List<ILoggingEvent> errorLogs = listAppender.list.stream()
                .filter(e -> e.getLevel() == Level.ERROR)
                .collect(Collectors.toList());
        long errorMsgCount = errorLogs.stream()
                .filter(e -> "发送html邮件时发生异常！".equals(e.getFormattedMessage()))
                .count();
        assertEquals((int) 1, (int) errorMsgCount);
    }
    @Test
    @Tag("valid")
    public void testSendHtmlMailValidTableDriven() {
        // Arrange
        // Table of scenarios
        String[][] cases = new String[][]{
                // subject, content
                {"", "<p>Minimal</p>"},
                {"Greetings", ""}
        };
        // Act & Assert
        for (String[] c : cases) {
            reset(mailSender);
            when(mailSender.createMimeMessage()).thenReturn(preparedMessage);
            // TODO: change the recipient address if needed
            String to = "recipient@example.com";
            String subject = c[0];
            String content = c[1];
            mailServiceImpl.sendHtmlMail(to, subject, content);
            verify(mailSender, times(1)).createMimeMessage();
            verify(mailSender, times(1)).send(same(preparedMessage));
            // Reset interactions and logs for next iteration
            clearInvocations(mailSender);
        }
        // Since logging assertions per-iteration would require clearing the appender list,
        // we only verify that at least one success log was recorded across runs.
        long successCount = listAppender.list.stream()
                .filter(e -> e.getLevel() == Level.INFO)
                .filter(e -> "html邮件发送成功".equals(e.getFormattedMessage()))
                .count();
        assertEquals((int) 2, (int) successCount);
    }
}