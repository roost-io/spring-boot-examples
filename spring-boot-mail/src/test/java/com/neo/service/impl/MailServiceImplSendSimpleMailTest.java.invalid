    @Test
    @Tag("valid")
    public void createsNewMessageOnEachInvocationAndDoesNotReuseState() {
        final String from = "no-reply@example.com";
        setFrom(from);
        final String to1 = "a@example.com";
        final String subject1 = "S1";
        final String content1 = "C1";
        final String to2 = "b@example.com";
        final String subject2 = "S2";
        final String content2 = "C2";
        assertDoesNotThrow(() -> mailServiceImpl.sendSimpleMail(to1, subject1, content1));
        assertDoesNotThrow(() -> mailServiceImpl.sendSimpleMail(to2, subject2, content2));
        ArgumentCaptor<SimpleMailMessage> captor = ArgumentCaptor.forClass(SimpleMailMessage.class);
        verify(mailSender, times(2)).send(captor.capture());
        List<SimpleMailMessage> messages = captor.getAllValues();
        SimpleMailMessage m1 = messages.get(0);
        SimpleMailMessage m2 = messages.get(1);
        assertNotSame((Object) m1, (Object) m2);
        assertArrayEquals((String[]) new String[]{to1}, (String[]) m1.getTo());
        assertEquals((String) subject1, (String) m1.getSubject());
        assertEquals((String) content1, (String) m1.getText());
        assertArrayEquals((String[]) new String[]{to2}, (String[]) m2.getTo());
        assertEquals((String) subject2, (String) m2.getSubject());
        assertEquals((String) content2, (String) m2.getText());
    }
    @Test
    @Tag("boundary")
    public void sendsMailWhenSubjectAndContentAreWhitespaceOnly() {
        final String from = "no-reply@example.com";
        final String to = "user@example.com";
        final String subject = "   ";
        final String content = "\n\t ";
        setFrom(from);
        assertDoesNotThrow(() -> mailServiceImpl.sendSimpleMail(to, subject, content));
        ArgumentCaptor<SimpleMailMessage> captor = ArgumentCaptor.forClass(SimpleMailMessage.class);
        verify(mailSender, times(1)).send(captor.capture());
        SimpleMailMessage sent = captor.getValue();
        assertEquals((String) subject, (String) sent.getSubject());
        assertEquals((String) content, (String) sent.getText());
    }
    @Test
    @Tag("boundary")
    public void passesToValueWithoutTrimmingLeadingOrTrailingSpaces() {
        final String from = "no-reply@example.com";
        final String to = "  user@example.com  ";
        final String subject = "S";
        final String content = "C";
        setFrom(from);
        assertDoesNotThrow(() -> mailServiceImpl.sendSimpleMail(to, subject, content));
        ArgumentCaptor<SimpleMailMessage> captor = ArgumentCaptor.forClass(SimpleMailMessage.class);
        verify(mailSender, times(1)).send(captor.capture());
        SimpleMailMessage sent = captor.getValue();
        assertArrayEquals((String[]) new String[]{to}, (String[]) sent.getTo());
    }
    @Test
    @Tag("valid")
    public void writesInfoLogOnSuccessfulSend() {
        final String from = "no-reply@example.com";
        final String to = "user@example.com";
        final String subject = "S";
        final String content = "C";
        setFrom(from);
        assertDoesNotThrow(() -> mailServiceImpl.sendSimpleMail(to, subject, content));
        List<ILoggingEvent> infos = appender.getEvents().stream().filter(e -> e.getLevel() == Level.INFO).toList();
        assertEquals((int) 1, (int) infos.size());
        assertEquals((String) "简单邮件已经发送。", (String) infos.get(0).getFormattedMessage());
        boolean hasError = appender.getEvents().stream().anyMatch(e -> e.getLevel() == Level.ERROR);
        assertFalse((boolean) hasError);
    }
    @Test
    @Tag("invalid")
    public void writesErrorLogOnSendFailureContainsException() {
        final String from = "no-reply@example.com";
        final String to = "user@example.com";
        final String subject = "S";
        final String content = "C";
        setFrom(from);
        RuntimeException ex = new RuntimeException("fail-here");
        doThrow(ex).when(mailSender).send(any(SimpleMailMessage.class));
        assertDoesNotThrow(() -> mailServiceImpl.sendSimpleMail(to, subject, content));
        List<ILoggingEvent> errors = appender.getEvents().stream().filter(e -> e.getLevel() == Level.ERROR).toList();
        assertTrue((boolean) errors.stream().anyMatch(e -> "发送简单邮件时发生异常！".equals(e.getFormattedMessage())
                && e.getThrowableProxy() != null
                && "java.lang.RuntimeException".equals(e.getThrowableProxy().getClassName())
                && "fail-here".equals(e.getThrowableProxy().getMessage())));
    }
    @Test
    @Tag("invalid")
    public void doesNotPropagateExceptionFromMailSenderSend() {
        final String from = "no-reply@example.com";
        final String to = "user@example.com";
        final String subject = "S";
        final String content = "C";
        setFrom(from);
        doThrow(new RuntimeException("x")).when(mailSender).send(any(SimpleMailMessage.class));
        assertDoesNotThrow(() -> mailServiceImpl.sendSimpleMail(to, subject, content));
        boolean hasError = appender.getEvents().stream().anyMatch(e -> e.getLevel() == Level.ERROR && "发送简单邮件时发生异常！".equals(e.getFormattedMessage()));
        assertTrue((boolean) hasError);
    }
    @Test
    @Tag("valid")
    public void setsAllMessageFieldsCorrectlyBeforeSending() {
        final String from = "sender@example.com"; // TODO change to your configured sender address if needed
        final String to = "recipient@example.com";
        final String subject = "Hello";
        final String content = "Greetings";
        setFrom(from);
        assertDoesNotThrow(() -> mailServiceImpl.sendSimpleMail(to, subject, content));
        ArgumentCaptor<SimpleMailMessage> captor = ArgumentCaptor.forClass(SimpleMailMessage.class);
        verify(mailSender, times(1)).send(captor.capture());
        SimpleMailMessage sent = captor.getValue();
        assertEquals((String) from, (String) sent.getFrom());
        assertArrayEquals((String[]) new String[]{to}, (String[]) sent.getTo());
        assertEquals((String) subject, (String) sent.getSubject());
        assertEquals((String) content, (String) sent.getText());
    }
    @Test
    @Tag("invalid")
    public void noLoggingWhenToIsNullAndSetterThrowsBeforeTryBlock() {
        final String from = "no-reply@example.com";
        final String subject = "S";
        final String content = "C";
        setFrom(from);
        assertThrows(IllegalArgumentException.class, () -> mailServiceImpl.sendSimpleMail(null, subject, content));
        verify(mailSender, never()).send(any(SimpleMailMessage.class));
        boolean hasInfo = appender.getEvents().stream().anyMatch(e -> e.getLevel() == Level.INFO);
        boolean hasError = appender.getEvents().stream().anyMatch(e -> e.getLevel() == Level.ERROR);
        assertFalse((boolean) hasInfo);
        assertFalse((boolean) hasError);
    }
}