    @Test
    @Tag("invalid")
    public void logsErrorAndSwallowsExceptionWhenMailSenderThrows() {
        final String from = "no-reply@example.com";
        final String to = "user@example.com";
        final String subject = "S";
        final String content = "C";
        setFrom(from);
        RuntimeException ex = new RuntimeException("send-failure");
        doThrow(ex).when(mailSender).send(any(SimpleMailMessage.class));
        assertDoesNotThrow(() -> mailServiceImpl.sendSimpleMail(to, subject, content));
        verify(mailSender, times(1)).send(any(SimpleMailMessage.class));
        List<ILoggingEvent> errors = appender.getEvents().stream().filter(e -> e.getLevel() == Level.ERROR).toList();
        assertTrue((boolean) errors.stream().anyMatch(e -> {
            boolean msgOk = "发送简单邮件时发生异常！".equals(e.getFormattedMessage());
            boolean throwablePresent = e.getThrowableProxy() != null && "java.lang.RuntimeException".equals(e.getThrowableProxy().getClassName())
                    && "send-failure".equals(e.getThrowableProxy().getMessage());
            return msgOk && throwablePresent;
        }));
        boolean hasInfo = appender.getEvents().stream().anyMatch(e -> e.getLevel() == Level.INFO && "简单邮件已经发送。".equals(e.getFormattedMessage()));
        assertFalse((boolean) hasInfo);
    }
