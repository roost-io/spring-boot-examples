@ExtendWith(MockitoExtension.class)
public class MailServiceImplSendSimpleMailTest {
    @InjectMocks
    private MailServiceImpl mailServiceImpl;
    @Mock
    private JavaMailSender mailSender;
    private Logger testLogger;
    private TestLogAppender appender;
    private static class TestLogAppender extends AppenderBase<ILoggingEvent> {
        private final List<ILoggingEvent> events = new CopyOnWriteArrayList<>();
        @Override
        protected void append(ILoggingEvent eventObject) {
            events.add(eventObject);
        }
        public List<ILoggingEvent> getEvents() {
            return events;
        }
        public void clear() {
            events.clear();
        }
    }
    @BeforeEach
    public void setUp() {
        testLogger = (Logger) LoggerFactory.getLogger(MailServiceImpl.class);
        appender = new TestLogAppender();
        appender.setContext(testLogger.getLoggerContext());
        appender.start();
        testLogger.addAppender(appender);
        appender.clear();
    }
    @AfterEach
    public void tearDown() {
        if (testLogger != null && appender != null) {
            testLogger.detachAppender(appender);
            appender.stop();
        }
    }
    private void setFrom(String from) {
        ReflectionTestUtils.setField(mailServiceImpl, "from", from);
    }
    private static String repeat(String unit, int times) {
        StringBuilder sb = new StringBuilder(unit.length() * times);
        for (int i = 0; i < times; i++) {
            sb.append(unit);
        }
        return sb.toString();
    }
    @Test
    @Tag("valid")
    public void sendsMailSuccessfullyWithValidInputs() {
        final String from = "no-reply@example.com"; // TODO change to your configured sender address if needed
        final String to = "user@example.com";
        final String subject = "Subject";
        final String content = "Body";
        setFrom(from);
        assertDoesNotThrow(() -> mailServiceImpl.sendSimpleMail(to, subject, content));
        ArgumentCaptor<SimpleMailMessage> captor = ArgumentCaptor.forClass(SimpleMailMessage.class);
        verify(mailSender, times(1)).send(captor.capture());
        SimpleMailMessage sent = captor.getValue();
        assertEquals((String) from, (String) sent.getFrom());
        assertArrayEquals((String[]) new String[]{to}, (String[]) sent.getTo());
        assertEquals((String) subject, (String) sent.getSubject());
        assertEquals((String) content, (String) sent.getText());
        List<ILoggingEvent> infos = appender.getEvents().stream().filter(e -> e.getLevel() == Level.INFO).toList();
        assertTrue((boolean) infos.stream().anyMatch(e -> "简单邮件已经发送。".equals(e.getFormattedMessage())));
    }
    @Test
    @Tag("invalid")
    public void throwsIllegalArgumentWhenToIsNullAndDoesNotSend() {
        final String from = "no-reply@example.com";
        final String subject = "Subject";
        final String content = "Body";
        setFrom(from);
        assertThrows(IllegalArgumentException.class, () -> mailServiceImpl.sendSimpleMail(null, subject, content));
        verify(mailSender, never()).send(any(SimpleMailMessage.class));
        boolean hasInfo = appender.getEvents().stream().anyMatch(e -> e.getLevel() == Level.INFO);
        boolean hasError = appender.getEvents().stream().anyMatch(e -> e.getLevel() == Level.ERROR);
        assertFalse((boolean) hasInfo);
        assertFalse((boolean) hasError);
    }
